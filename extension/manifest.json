{
    "manifest_version": 3,
    "name": "Privacy Browser Agent",
    "version": "0.1.0",
    "description": "Privacy-preserving browser agent with local visual perception.",
    "permissions": [
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Privacy Browser Agent"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "dist/content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}